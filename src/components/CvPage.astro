---
import Base from '../layouts/Base.astro'
import Header from './Header.astro'
import Hero from './Hero.astro'
import Section from './Section.astro'
import Icon from './Icon.astro'
import { copy, profile, type Lang } from '../data/cv'

interface Props { lang: Lang }
const { lang } = Astro.props
const t = copy[lang]
---
<Base lang={lang}>
  <a class="skip-link" href="#main">{t.a11y.skip}</a>
  <Header lang={lang} />

  <main id="main" tabindex="-1">
    <Hero lang={lang} />

    <Section id="about" index="01" title={t.about.title}>
      <p class="lead">{t.about.lead}</p>
      <p class="prose">{t.about.text}</p>
      <ul class="services" role="list">
        {t.about.services.map(service => (
          <li class="card service">
            <span class="badge-icon"><Icon name={service.icon} size={20} /></span>
            <h3>{service.title}</h3>
            <p>{service.text}</p>
          </li>
        ))}
      </ul>
      <a class="text-link" href={profile.portfolio} target="_blank" rel="noopener noreferrer">
        {t.about.portfolio}<Icon name="external-link" size={16} />
      </a>
    </Section>

    <Section id="skills" index="02" title={t.skills.title}>
      <div class="skill-groups">
        {t.skills.groups.map(group => (
          <div class="skill-group">
            <h3>{group.title}</h3>
            <ul class="chips" role="list" translate="no">
              {group.items.map(item => <li class="chip">{item}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </Section>

    <Section id="projects" index="03" title={t.projects.title}>
      <div class="projects">
        {t.projects.items.map(project => (
          <article class="card project">
            <header class="project-head">
              <div>
                <h3>{project.title}</h3>
                <p class="project-role">{project.role}</p>
              </div>
              <a class="text-link" href={project.url} target="_blank" rel="noopener noreferrer">
                {project.link}<Icon name="external-link" size={16} />
              </a>
            </header>
            <ul class="chips small" role="list" translate="no">
              {project.stack.map(item => <li class="chip">{item}</li>)}
            </ul>
            <ul class="bullets">
              {project.results.map(result => <li>{result}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </Section>

    <Section id="education" index="04" title={t.education.title}>
      <div class="card education">
        <span class="badge-icon"><Icon name="graduation" size={22} /></span>
        <div>
          <h3 lang="az" translate="no">{profile.school}</h3>
          <p class="edu-field">{t.education.field}</p>
          <p class="edu-period">{t.education.period}</p>
        </div>
      </div>
    </Section>

    <Section id="languages" index="05" title={t.spoken.title}>
      <ul class="languages" role="list">
        {t.spoken.items.map(item => (
          <li class="card language">
            <div>
              <h3>{item.name}</h3>
              <p>{item.level}</p>
            </div>
            <span class="meter" role="img" aria-label={`${item.score}/5`}>
              {[1, 2, 3, 4, 5].map(step => <span class:list={{ on: step <= item.score }} />)}
            </span>
          </li>
        ))}
      </ul>
    </Section>

    <section id="contact" class="contact" aria-labelledby="contact-title">
      <div class="container">
        <div class="contact-card">
          <div>
            <p class="eyebrow">{t.contact.eyebrow}</p>
            <h2 id="contact-title">{t.contact.title}<span class="accent">.</span></h2>
            <p class="contact-text">{t.contact.text}</p>
          </div>
          <div class="contact-actions">
            <a class="button primary" href={`mailto:${profile.email}`}><Icon name="mail" />{t.contact.email}</a>
            <a class="button ghost" href={profile.telegram} target="_blank" rel="noopener noreferrer"><Icon name="send" />{t.contact.telegram}</a>
          </div>
          <address class="contact-address">
            <ul class="contact-list" role="list">
              <li><Icon name="mail" size={16} /><a href={`mailto:${profile.email}`}>{profile.email}</a></li>
              <li><Icon name="phone" size={16} /><a href={profile.phone.href}>{profile.phone.label}</a></li>
              {profile.links.map(link => (
                <li><Icon name={link.icon} size={16} /><a href={link.href} target="_blank" rel="me noopener noreferrer">{link.href.replace('https://', '').replace('www.', '')}</a></li>
              ))}
            </ul>
          </address>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container footer-inner">
      <p>© {new Date().getFullYear()} <span translate="no">{t.name}</span> · {t.footer.tagline}</p>
      <a href="#main">{t.footer.top}<Icon name="arrow-up" size={16} /></a>
    </div>
  </footer>
</Base>
